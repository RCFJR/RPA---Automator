<svg viewBox="0 0 200 240" xmlns="http://www.w3.org/2000/svg">
  <!-- Head -->
  <rect x="45" y="20" width="110" height="100" rx="15" fill="#001f3f" stroke="#00d4ff" stroke-width="3"/>

  <!-- Head top -->
  <rect x="65" y="5" width="70" height="25" rx="8" fill="#001f3f" stroke="#00d4ff" stroke-width="3"/>

  <!-- Left antenna -->
  <g>
    <line x1="75" y1="5" x2="65" y2="-15" stroke="#00d4ff" stroke-width="3" stroke-linecap="round"/>
    <circle cx="65" cy="-15" r="5" fill="#00d4ff"/>
  </g>

  <!-- Right antenna -->
  <g>
    <line x1="125" y1="5" x2="135" y2="-15" stroke="#00d4ff" stroke-width="3" stroke-linecap="round"/>
    <circle cx="135" cy="-15" r="5" fill="#00d4ff"/>
  </g>

  <!-- Left eye -->
  <rect x="60" y="45" width="18" height="28" rx="9" fill="#00d4ff"/>

  <!-- Right eye -->
  <rect x="122" y="45" width="18" height="28" rx="9" fill="#00d4ff"/>

  <!-- Left ear -->
  <ellipse cx="35" cy="60" rx="12" ry="22" fill="#001f3f" stroke="#00d4ff" stroke-width="3"/>
  <ellipse cx="35" cy="60" rx="6" ry="15" fill="#00d4ff"/>

  <!-- Right ear -->
  <ellipse cx="165" cy="60" rx="12" ry="22" fill="#001f3f" stroke="#00d4ff" stroke-width="3"/>
  <ellipse cx="165" cy="60" rx="6" ry="15" fill="#00d4ff"/>

  <!-- Smile -->
  <path d="M 80 95 Q 100 110 120 95" stroke="#00d4ff" stroke-width="3" fill="none" stroke-linecap="round"/>

  <!-- Body -->
  <rect x="40" y="120" width="120" height="80" rx="12" fill="#001f3f" stroke="#00d4ff" stroke-width="3"/>

  <!-- Body screen -->
  <rect x="55" y="145" width="90" height="45" rx="8" fill="#00d4ff" opacity="0.2" stroke="#00d4ff" stroke-width="2"/>

  <!-- Left arm -->
  <g>
    <rect x="20" y="135" width="20" height="50" rx="10" fill="#001f3f" stroke="#00d4ff" stroke-width="3"/>
    <circle cx="30" cy="160" r="8" fill="#00d4ff"/>
  </g>

  <!-- Right arm -->
  <g>
    <rect x="160" y="135" width="20" height="50" rx="10" fill="#001f3f" stroke="#00d4ff" stroke-width="3"/>
    <circle cx="170" cy="160" r="8" fill="#00d4ff"/>
  </g>

  <!-- Bottom accent -->
  <rect x="60" y="200" width="80" height="12" rx="6" fill="#00d4ff"/>
</svg>
