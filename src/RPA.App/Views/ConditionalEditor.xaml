<UserControl x:Class="RPA.App.Views.ConditionalEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Editor de Condições com Imagem"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,20" />

            <TextBlock Name="StatusText"
                       Text="Pronto"
                       FontSize="12"
                       Margin="0,0,0,20" />

            <GroupBox Header="Capturar Snapshot" Margin="0,0,0,20" Padding="10">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Name="SnapshotNameInput"
                                 Width="200"
                                 Padding="8,5"
                                 Margin="0,0,10,0" />
                        <Button Name="CaptureButton"
                                Content="Capturar Snapshot"
                                Padding="15,8"
                                Background="Green"
                                Foreground="White"
                                FontWeight="Bold"
                                Click="CaptureButton_Click" />
                    </StackPanel>

                    <TextBlock Text="Snapshots:" FontWeight="Bold" Margin="0,10,0,5" />
                    <ListBox Name="SnapshotsList" Height="150" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Configurar Condição" Padding="10">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Threshold (%): 100" Margin="0,0,0,10" />
                    <Slider Minimum="0" Maximum="100" Value="100" Width="200" Margin="0,0,0,10" />
                    <TextBlock Text="Preview do Snapshot Selecionado" FontWeight="Bold" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
